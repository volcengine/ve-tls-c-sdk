@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@VE_TLS_PACKAGE_NEEDS_THREADS@)
    find_dependency(Threads)
endif()
if(@VE_TLS_PACKAGE_NEEDS_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@VE_TLS_PACKAGE_NEEDS_CURL@)
    find_dependency(CURL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ve_tls_coreTargets.cmake")

check_required_components(ve_tls_core)
